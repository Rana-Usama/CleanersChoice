# Copy to .env and fill in. Never commit the filled-in file.
# Firebase client config is safe to expose (it ships inside the app bundle);
# it is protected by Firestore/Storage Security Rules, not by secrecy.
# GOOGLE_PLACES_API_KEY is billable -- restrict the key by bundle ID /
# package + SHA-1, and to the Places and Geocoding APIs only.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
PUBLISHABLE_KEY=
GOOGLE_PLACES_API_KEY=
