yarn-error.log
# Secrets and local config. Values live in .env; .env.example documents the
# keys without them. NOTE: these rules only apply to files git is not already
# tracking -- a file added to the index before it was listed here keeps being
# committed until `git rm --cached` removes it.
.env
.env.*
!.env.example
android/app/google-services.json
# The plist moved to ios/ at some point but this list was never updated, so it
# was tracked unignored for its whole life. Both paths listed deliberately.
ios/GoogleService-Info.plist
ios/CleanersChoice/GoogleService-Info.plist
**/.xcode.env.local.*

# Decompiled app bundles. Build output, and index.android.bundle inside one
# embeds every @env value at build time -- it is how the Places key ended up
# in public history a second time, independently of .env.
aab_extracted/
*.aab
# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Tool-generated backups (Xcode, sed -i, version-bump scripts)
*.bak
*.orig

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
